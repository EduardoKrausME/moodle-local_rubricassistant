{{!
    @template local_rubricassistant/review

    Example context (json):
    {
        Aqui tem que criar o context em inglês
    }
}}
<div class="local-rubricassistant-review">
    <div class="alert alert-info">
        {{#str}}reviewnotice, local_rubricassistant{{/str}}
        <div class="small mt-1">{{#str}}expires, local_rubricassistant{{/str}}</div>
    </div>

    <p><strong>{{#str}}targetmethod, local_rubricassistant{{/str}}:</strong> {{methodlabel}}</p>

    {{#hasfindings}}
        <section class="mb-4">
            <h3 class="h5">{{#str}}findings, local_rubricassistant{{/str}}</h3>
            <div class="list-group">
                {{#findings}}
                    <div class="list-group-item">
                        <div><strong>{{type}}</strong>{{#severity}}
                            <span class="badge bg-secondary">{{severity}}</span>{{/severity}}</div>
                        <div>{{message}}</div>
                    </div>
                {{/findings}}
            </div>
        </section>
    {{/hasfindings}}

    {{#hasalignment}}
        <section class="mb-4">
            <h3 class="h5">{{#str}}alignment, local_rubricassistant{{/str}}</h3>
            <div class="list-group">
                {{#alignment}}
                    <div class="list-group-item">
                        <div><strong>{{source}}</strong>{{#sourceid}}
                            <span class="text-muted">#{{sourceid}}</span>{{/sourceid}}{{#status}}
                            — {{status}}{{/status}}</div>
                        <div>{{message}}</div>
                    </div>
                {{/alignment}}
            </div>
        </section>
    {{/hasalignment}}

    {{#hascriteria}}
        <form method="post" action="{{formaction}}">
            <input type="hidden" name="cmid" value="{{cmid}}">
            <input type="hidden" name="token" value="{{token}}">
            <input type="hidden" name="sesskey" value="{{sesskey}}">

            <h3 class="h5 mb-3">{{#str}}proposal, local_rubricassistant{{/str}}</h3>
            {{#criteria}}
                <article class="card mb-3 local-rubricassistant-criterion">
                    <div class="card-header">
                        <div class="fw-bold mb-2">
                            {{#isnew}}{{#str}}newcriterion, local_rubricassistant{{/str}}{{/isnew}}
                            {{^isnew}}{{#str}}acceptchange, local_rubricassistant{{/str}}{{/isnew}}
                        </div>
                        <div class="d-flex flex-wrap gap-3">
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="{{decisionname}}" value="accept"
                                       id="{{acceptid}}">
                                <label class="form-check-label" for="{{acceptid}}">{{#str}}
                                    accept, local_rubricassistant{{/str}}</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="{{decisionname}}" value="reject"
                                       id="{{rejectid}}" checked>
                                <label class="form-check-label" for="{{rejectid}}">{{#str}}
                                    reject, local_rubricassistant{{/str}}</label>
                            </div>
                        </div>
                    </div>
                    <div class="card-body">
                        {{^isnew}}
                            <div class="local-rubricassistant-current mb-3 p-3 bg-light rounded">
                                <div class="fw-bold mb-2">{{#str}}current, local_rubricassistant{{/str}}</div>
                                {{#currentname}}
                                    <div><strong>{{currentname}}</strong></div>{{/currentname}}
                                <div>{{currentdescription}}</div>
                                {{#currentmaxscore}}
                                    <div class="small mt-1">{{#str}}maxscore, local_rubricassistant{{/str}}
                                        : {{currentmaxscore}}</div>{{/currentmaxscore}}
                                {{#currentlevels}}
                                    <div class="small mt-1">{{score}} — {{definition}}</div>
                                {{/currentlevels}}
                            </div>
                        {{/isnew}}

                        {{#isguide}}
                            <div class="mb-3">
                                <label class="form-label" for="{{namename}}">{{#str}}
                                    criterionname, local_rubricassistant{{/str}}</label>
                                <input class="form-control" type="text" id="{{namename}}" name="{{namename}}"
                                       value="{{name}}" maxlength="255">
                            </div>
                        {{/isguide}}

                        <div class="mb-3">
                            <label class="form-label" for="{{descriptionname}}">{{#str}}
                                criteriondescription, local_rubricassistant{{/str}}</label>
                            <textarea class="form-control" id="{{descriptionname}}" name="{{descriptionname}}"
                                      rows="3">{{description}}</textarea>
                        </div>

                        {{#isrubric}}
                            <div class="table-responsive mb-3">
                                <table class="table table-sm align-middle">
                                    <thead>
                                    <tr>
                                        <th>{{#str}}score, local_rubricassistant{{/str}}</th>
                                        <th>{{#str}}leveldefinition, local_rubricassistant{{/str}}</th>
                                    </tr>
                                    </thead>
                                    <tbody>
                                    {{#levels}}
                                        <tr>
                                            <td class="local-rubricassistant-score">
                                                <input class="form-control" type="number" step="any"
                                                       name="{{scorename}}" value="{{score}}">
                                            </td>
                                            <td>
                                                <textarea class="form-control" name="{{definitionname}}"
                                                          rows="2">{{definition}}</textarea>
                                            </td>
                                        </tr>
                                    {{/levels}}
                                    </tbody>
                                </table>
                            </div>
                        {{/isrubric}}

                        {{#isguide}}
                            <div class="mb-3">
                                <label class="form-label" for="{{markersname}}">{{#str}}
                                    markers, local_rubricassistant{{/str}}</label>
                                <textarea class="form-control" id="{{markersname}}" name="{{markersname}}"
                                          rows="3">{{markers}}</textarea>
                            </div>
                            <div class="mb-3">
                                <label class="form-label" for="{{maxscorename}}">{{#str}}
                                    maxscore, local_rubricassistant{{/str}}</label>
                                <input class="form-control local-rubricassistant-score" type="number" min="0" step="any"
                                       id="{{maxscorename}}" name="{{maxscorename}}" value="{{maxscore}}">
                            </div>
                        {{/isguide}}

                        {{#rationale}}
                            <div class="small text-muted"><strong>{{#str}}
                                rationale, local_rubricassistant{{/str}}:</strong> {{rationale}}</div>
                        {{/rationale}}
                    </div>
                </article>
            {{/criteria}}

            {{#hasactiveinstances}}
                <div class="form-check mb-3">
                    <input class="form-check-input" type="checkbox" name="confirmregrade" value="1" id="confirmregrade">
                    <label class="form-check-label" for="confirmregrade">{{#str}}
                        regradeconfirm, local_rubricassistant{{/str}}</label>
                </div>
            {{/hasactiveinstances}}

            {{#canapply}}
                <button type="submit" class="btn btn-primary">{{#str}}
                    applyselected, local_rubricassistant{{/str}}</button>
            {{/canapply}}
            {{#cannotapply}}
                <div class="alert alert-warning">{{#str}}cannotapply, local_rubricassistant{{/str}}</div>
            {{/cannotapply}}
        </form>
    {{/hascriteria}}

    {{^hascriteria}}
        <div class="alert alert-secondary">{{#str}}nochangesproposed, local_rubricassistant{{/str}}</div>
    {{/hascriteria}}

    <p class="mt-4"><a class="btn btn-secondary" href="{{{backurl}}}">{{#str}}back, local_rubricassistant{{/str}}</a></p>
</div>
